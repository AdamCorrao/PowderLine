' Generated by PowderLine topas-kicker from example_DRX_33/input.json (schema 0.26.0)
' Documented approximations: Chebyshev basis transfer (D11); Polariz. 0.99 -> LP_Factor(90) (D5); SH/L 0.0005 omitted, no axial model (D4).
' Data: example_DRX_33.xye carries the full pattern; 0 point(s) with non-positive weight dropped.
' Note: when a recipe refines multiple correlated profile terms (instrument U..Z; size<->strain), those individual values are not uniquely determined (D6/findings D.6); cell, scale and occupancy are reliable.
iters 100000
do_errors
chi2_convergence_criteria 0.001

r_wp 0 r_exp 0 gof 0

' --- global instrument profile prms (GSAS-II units: U,V,W centideg^2 variance; X,Y,Z centideg FWHM) ---
prm !inst_U 18.71740851
prm !inst_V 0.6003411256
prm !inst_W 1.147013008
prm !inst_X 0.2814303432
prm !inst_Y 0.001
prm !inst_Z 0

xdd "example_DRX_33.xye" xye_format
    start_X 1
    finish_X 15
    x_calculation_step 0.001

    ' background: 6-term Chebyshev (D11); TOPAS names the coefficients chebyshev_bkg_bkg0__ .. chebyshev_bkg_bkg5__
    bkg chebyshev_bkg 10 5 1 0 0 0

    ' emission: single synchrotron line (findings B.6); lh is a delta-function width
    lam ymin_on_ymax 0.001 la 1 lo 0.1665 lh 1e-5

    str
        phase_name "DRX_33"
        space_group "F m -3 m"
        ' scale start = recipe scale 1 x 1e-06 (GSAS-II->TOPAS magnitude; refined)
        scale DRX_33_scale 1e-06
        r_bragg 0
        a DRX_33_a 4.1813   b DRX_33_a 4.1813   c DRX_33_a 4.1813
        al 90   be 90   ga 90
        ' merged shared site (D7): Li, Mg, Mn1, W
        site Li x 0 y 0 z 0 occ Li 0.6 beq !DRX_33_Li_beq 0.4026798596 occ Mg 0.1 beq !DRX_33_Mg_beq 0.4026798596 occ Mn 0.2 beq !DRX_33_Mn1_beq 0.4026798596 occ W 0.1 beq !DRX_33_W_beq 0.4026798596
        site O1 x 0.5 y 0.5 z 0.5 occ O 1 beq !DRX_33_O1_beq 0.773776985
        ' instrument profile as literal GSAS-II convolutions (D4); prms are global
        gauss_fwhm = 0.0235482 Sqrt(Max(inst_U Tan(Th)^2 + inst_V Tan(Th) + inst_W, 1e-9));
        lor_fwhm   = Max(0.01 (inst_X / Cos(Th) + inst_Y Tan(Th) + inst_Z), 1e-9);
        LP_Factor(90)
        ' sample broadening: literal GSAS-II parameterization (D2; findings C.1)
        prm DRX_33_size_um 1 min 1e-6
        prm DRX_33_size_eta 1 min 0 max 1
        prm DRX_33_strain 1 min 1e-6
        prm DRX_33_strain_eta 1 min 0 max 1
        lor_fwhm   = Max(0.018 DRX_33_size_eta Lam / (Pi DRX_33_size_um Cos(Th)), 1e-9);
        gauss_fwhm = Max(0.018 (1 - DRX_33_size_eta) Lam / (Pi DRX_33_size_um Cos(Th)), 1e-9);
        lor_fwhm   = Max(1.8e-4 DRX_33_strain_eta DRX_33_strain Tan(Th) / Pi, 1e-9);
        gauss_fwhm = Max(1.8e-4 (1 - DRX_33_strain_eta) DRX_33_strain Tan(Th) / Pi, 1e-9);
        phase_out "DRX_33_topas_peaks.txt" load out_record out_fmt out_eqn
        {
            " %.0f" = H;
            " %.0f" = K;
            " %.0f" = L;
            " %.0f" = M;
            " %.8g" = D_spacing;
            " %.8g" = 2 Rad Th;
            " %.8g" = I_no_scale_pks;
            " %.8g" = I_after_scale_pks;
            " %.8g" = Iobs_no_scale_pks;
            " %.8g" = A01;
            " %.8g" = B01;
            " %.8g" = A11;
            " %.8g\n" = B11;
        }

    str
        phase_name "Li4MgWO6_SG12"
        space_group "C2/m"
        ' scale start = recipe scale 1 x 1e-06 (GSAS-II->TOPAS magnitude; refined)
        scale Li4MgWO6_SG12_scale 1e-06
        r_bragg 0
        a Li4MgWO6_SG12_a 5.092   b Li4MgWO6_SG12_b 8.794   c Li4MgWO6_SG12_c 5.061
        al 90   be Li4MgWO6_SG12_beta 109.96   ga 90
        site Li1 x 0 y 0.33 z 0.5 occ Li 1 beq !Li4MgWO6_SG12_Li1_beq 0
        ' merged shared site (D7): Li2, Mg
        site Li2 x 0 y 0.167 z 0 occ Li 0.5 beq !Li4MgWO6_SG12_Li2_beq 0 occ Mg 0.5 beq !Li4MgWO6_SG12_Mg_beq 0
        site Li3 x 0 y 0 z 0.5 occ Li 1 beq !Li4MgWO6_SG12_Li3_beq 0
        site O1 x 0.238 y 0.343 z 0.234 occ O 1 beq !Li4MgWO6_SG12_O1_beq 0
        site O2 x 0.259 y 0 z 0.226 occ O 1 beq !Li4MgWO6_SG12_O2_beq 0
        site W x 0 y 0.5 z 0 occ W 1 beq !Li4MgWO6_SG12_W_beq 0
        ' instrument profile as literal GSAS-II convolutions (D4); prms are global
        gauss_fwhm = 0.0235482 Sqrt(Max(inst_U Tan(Th)^2 + inst_V Tan(Th) + inst_W, 1e-9));
        lor_fwhm   = Max(0.01 (inst_X / Cos(Th) + inst_Y Tan(Th) + inst_Z), 1e-9);
        LP_Factor(90)
        ' sample broadening: literal GSAS-II parameterization (D2; findings C.1)
        prm Li4MgWO6_SG12_size_um 1 min 1e-6
        prm Li4MgWO6_SG12_size_eta 1 min 0 max 1
        prm Li4MgWO6_SG12_strain 1 min 1e-6
        prm Li4MgWO6_SG12_strain_eta 1 min 0 max 1
        lor_fwhm   = Max(0.018 Li4MgWO6_SG12_size_eta Lam / (Pi Li4MgWO6_SG12_size_um Cos(Th)), 1e-9);
        gauss_fwhm = Max(0.018 (1 - Li4MgWO6_SG12_size_eta) Lam / (Pi Li4MgWO6_SG12_size_um Cos(Th)), 1e-9);
        lor_fwhm   = Max(1.8e-4 Li4MgWO6_SG12_strain_eta Li4MgWO6_SG12_strain Tan(Th) / Pi, 1e-9);
        gauss_fwhm = Max(1.8e-4 (1 - Li4MgWO6_SG12_strain_eta) Li4MgWO6_SG12_strain Tan(Th) / Pi, 1e-9);
        phase_out "Li4MgWO6_SG12_topas_peaks.txt" load out_record out_fmt out_eqn
        {
            " %.0f" = H;
            " %.0f" = K;
            " %.0f" = L;
            " %.0f" = M;
            " %.8g" = D_spacing;
            " %.8g" = 2 Rad Th;
            " %.8g" = I_no_scale_pks;
            " %.8g" = I_after_scale_pks;
            " %.8g" = Iobs_no_scale_pks;
            " %.8g" = A01;
            " %.8g" = B01;
            " %.8g" = A11;
            " %.8g\n" = B11;
        }

' --- fit profile (headerless: X Yobs 1/sig^2 Ycalc Yobs-Ycalc bkg) ---
xdd_out "example_DRX_33_topas_profile.txt" load out_record out_fmt out_eqn
{
    " %.8g" = X;
    " %.8g" = Yobs;
    " %.8g" = 1 / SigmaYobs^2;
    " %.8g" = Ycalc;
    " %.8g" = Yobs - Ycalc;
    " %.8g\n" = Get(bkg);
}

' --- structured results export (comment-free CSV; parsed by roundtrip.py) ---
' raw out_record primitives (NOT the Out/Out_String macros: those comma-split)
out "example_DRX_33_results.csv"
    out_record out_fmt "parameter,value,esd\n"
    out_record out_eqn = Get(r_wp); out_fmt "r_wp,%11.8g,\n"
    out_record out_eqn = Get(r_exp); out_fmt "r_exp,%11.8g,\n"
    out_record out_eqn = Get(gof); out_fmt "gof,%11.8g,\n"
    out_record out_eqn = chebyshev_bkg_bkg0__; out_fmt "chebyshev_bkg_bkg0__,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = chebyshev_bkg_bkg1__; out_fmt "chebyshev_bkg_bkg1__,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = chebyshev_bkg_bkg2__; out_fmt "chebyshev_bkg_bkg2__,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = chebyshev_bkg_bkg3__; out_fmt "chebyshev_bkg_bkg3__,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = chebyshev_bkg_bkg4__; out_fmt "chebyshev_bkg_bkg4__,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = chebyshev_bkg_bkg5__; out_fmt "chebyshev_bkg_bkg5__,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = DRX_33_scale; out_fmt "DRX_33_scale,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = DRX_33_a; out_fmt "DRX_33_a,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = DRX_33_size_um; out_fmt "DRX_33_size_um,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = DRX_33_size_eta; out_fmt "DRX_33_size_eta,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = DRX_33_strain; out_fmt "DRX_33_strain,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = DRX_33_strain_eta; out_fmt "DRX_33_strain_eta,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = Li4MgWO6_SG12_scale; out_fmt "Li4MgWO6_SG12_scale,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = Li4MgWO6_SG12_a; out_fmt "Li4MgWO6_SG12_a,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = Li4MgWO6_SG12_b; out_fmt "Li4MgWO6_SG12_b,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = Li4MgWO6_SG12_c; out_fmt "Li4MgWO6_SG12_c,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = Li4MgWO6_SG12_beta; out_fmt "Li4MgWO6_SG12_beta,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = Li4MgWO6_SG12_size_um; out_fmt "Li4MgWO6_SG12_size_um,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = Li4MgWO6_SG12_size_eta; out_fmt "Li4MgWO6_SG12_size_eta,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = Li4MgWO6_SG12_strain; out_fmt "Li4MgWO6_SG12_strain,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = Li4MgWO6_SG12_strain_eta; out_fmt "Li4MgWO6_SG12_strain_eta,%11.8g," out_fmt_err "%11.8g\n"
' per-phase cell report (a,b,c,al,be,ga,volume with TOPAS ESDs)
    out_record out_eqn = DRX_33_a; out_fmt "DRX_33_cell_a,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = DRX_33_a; out_fmt "DRX_33_cell_b,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = DRX_33_a; out_fmt "DRX_33_cell_c,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = 90; out_fmt "DRX_33_cell_alpha,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = 90; out_fmt "DRX_33_cell_beta,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = 90; out_fmt "DRX_33_cell_gamma,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = (DRX_33_a) * (DRX_33_a) * (DRX_33_a) * Sqrt(1 - Cos((90) * Pi / 180)^2 - Cos((90) * Pi / 180)^2 - Cos((90) * Pi / 180)^2 + 2 * Cos((90) * Pi / 180) * Cos((90) * Pi / 180) * Cos((90) * Pi / 180)); out_fmt "DRX_33_cell_volume,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = Li4MgWO6_SG12_a; out_fmt "Li4MgWO6_SG12_cell_a,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = Li4MgWO6_SG12_b; out_fmt "Li4MgWO6_SG12_cell_b,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = Li4MgWO6_SG12_c; out_fmt "Li4MgWO6_SG12_cell_c,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = 90; out_fmt "Li4MgWO6_SG12_cell_alpha,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = Li4MgWO6_SG12_beta; out_fmt "Li4MgWO6_SG12_cell_beta,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = 90; out_fmt "Li4MgWO6_SG12_cell_gamma,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = (Li4MgWO6_SG12_a) * (Li4MgWO6_SG12_b) * (Li4MgWO6_SG12_c) * Sqrt(1 - Cos((90) * Pi / 180)^2 - Cos((Li4MgWO6_SG12_beta) * Pi / 180)^2 - Cos((90) * Pi / 180)^2 + 2 * Cos((90) * Pi / 180) * Cos((Li4MgWO6_SG12_beta) * Pi / 180) * Cos((90) * Pi / 180)); out_fmt "Li4MgWO6_SG12_cell_volume,%11.8g," out_fmt_err "%11.8g\n"
