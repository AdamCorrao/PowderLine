' --- fit profile (headerless: X Yobs 1/sig^2 Ycalc Yobs-Ycalc bkg) ---
xdd_out "example_LaB6_singlepeakfit_topas_profile.txt" load out_record out_fmt out_eqn
{
    " %.8g" = X;
    " %.8g" = Yobs;
    " %.8g" = 1 / SigmaYobs^2;
    " %.8g" = Ycalc;
    " %.8g" = Yobs - Ycalc;
    " %.8g\n" = Get(bkg);
}

' --- structured results export (comment-free CSV; parsed by roundtrip.py) ---
' raw out_record primitives (NOT the Out/Out_String macros: those comma-split)
out "example_LaB6_singlepeakfit_results.csv"
    out_record out_fmt "parameter,value,esd\n"
