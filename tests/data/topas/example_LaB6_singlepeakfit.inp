' Generated by PowderLine topas-kicker from example_LaB6_singlepeakfit/input.json (schema 0.26.0)
' Documented approximations: Chebyshev basis transfer (D11); Polariz. 0.99 -> LP_Factor(90) (D5); SH/L 0 omitted, no axial model (D4).
' Data: example_LaB6_singlepeakfit.xye carries the full pattern; 0 point(s) with non-positive weight dropped.
iters 100000
do_errors
chi2_convergence_criteria 0.001

r_wp 0 r_exp 0 gof 0

xdd "example_LaB6_singlepeakfit.xye" xye_format
    start_X 1
    finish_X 15
    x_calculation_step 0.001

    ' background: 6-term Chebyshev (D11); TOPAS names the coefficients chebyshev_bkg_bkg0__ .. chebyshev_bkg_bkg5__
    bkg chebyshev_bkg 10 5 1 0 0 0

    ' emission: single synchrotron line (findings B.6); lh is a delta-function width
    lam ymin_on_ymax 0.001 la 1 lo 0.1665 lh 1e-5

    ' --- single-peak fit: 36 pseudo-Voigt peak(s); sigma is variance (sigma^2) ---
    xo_Is
        peak_type pv pv_lor 0 pv_fwhm 0.0001
        xo spfpk0_pos 2.29
        I spfpk0_int 3000
        prm spfpk0_sigsq 0.1 min 1e-6
        prm spfpk0_gam 1 min 1e-6
        gauss_fwhm = 0.0235482 Sqrt(spfpk0_sigsq);
        lor_fwhm   = 0.01 spfpk0_gam;
    xo_Is
        peak_type pv pv_lor 0 pv_fwhm 0.0001
        xo spfpk1_pos 3.25
        I spfpk1_int 3000
        prm spfpk1_sigsq 0.1 min 1e-6
        prm spfpk1_gam 1 min 1e-6
        gauss_fwhm = 0.0235482 Sqrt(spfpk1_sigsq);
        lor_fwhm   = 0.01 spfpk1_gam;
