' Generated by PowderLine topas-kicker from example_LaB6/input.json (schema 0.26.0)
' Documented approximations: Chebyshev basis transfer (D11); Polariz. 0.99 -> LP_Factor(90) (D5); SH/L 0.0005 omitted, no axial model (D4).
' Data: example_LaB6.xye carries the full pattern; 0 point(s) with non-positive weight dropped.
' Note: when a recipe refines multiple correlated profile terms (instrument U..Z; size<->strain), those individual values are not uniquely determined (D6/findings D.6); cell, scale and occupancy are reliable.
iters 100000
do_errors
chi2_convergence_criteria 0.001

r_wp 0 r_exp 0 gof 0

' --- global instrument profile prms (GSAS-II units: U,V,W centideg^2 variance; X,Y,Z centideg FWHM) ---
prm inst_U 18.71740851
prm inst_V 0.6003411256
prm inst_W 1.147013008
prm inst_X 0.2814303432
prm inst_Y 0.001
prm inst_Z 0

xdd "example_LaB6.xye" xye_format
    start_X 1
    finish_X 15
    x_calculation_step 0.001

    ' background: 6-term Chebyshev (D11); TOPAS names the coefficients chebyshev_bkg_bkg0__ .. chebyshev_bkg_bkg5__
    bkg chebyshev_bkg 10 5 1 0 0 0

    ' emission: single synchrotron line (findings B.6); lh is a delta-function width
    lam ymin_on_ymax 0.001 la 1 lo 0.1665 lh 1e-5

    ' --- background single peak 0: sigma/gamma are THE prms (D2) ---
    xo_Is
        peak_type pv pv_lor 0 pv_fwhm 0.0001
        xo bkgpk0_pos 1.5
        I bkgpk0_int 1
        prm bkgpk0_sig 1000 min 1e-6
        prm bkgpk0_gam 1e-05 min 1e-6
        gauss_fwhm = 0.0235482 bkgpk0_sig;
        lor_fwhm   = 0.01 bkgpk0_gam;

    str
        phase_name "LaB6"
        space_group "P m -3 m"
        ' scale start = recipe scale 1 x 1e-06 (GSAS-II->TOPAS magnitude; refined)
        scale LaB6_scale 1e-06
        r_bragg 0
        a !LaB6_a 4.15682   b !LaB6_a 4.15682   c !LaB6_a 4.15682
        al 90   be 90   ga 90
        site B x 0.5 y 0.5 z 0.2021 occ B 1 beq !LaB6_B_beq 0.7106115169
        site La x 0 y 0 z 0 occ La 1 beq !LaB6_La_beq 0.6774496461
        ' instrument profile as literal GSAS-II convolutions (D4); prms are global
        gauss_fwhm = 0.0235482 Sqrt(Max(inst_U Tan(Th)^2 + inst_V Tan(Th) + inst_W, 1e-9));
        lor_fwhm   = Max(0.01 (inst_X / Cos(Th) + inst_Y Tan(Th) + inst_Z), 1e-9);
        LP_Factor(90)
        ' sample broadening: literal GSAS-II parameterization (D2; findings C.1)
        prm !LaB6_size_um 10
        prm !LaB6_size_eta 1 min 0 max 1
        lor_fwhm   = Max(0.018 LaB6_size_eta Lam / (Pi LaB6_size_um Cos(Th)), 1e-9);
        phase_out "LaB6_topas_peaks.txt" load out_record out_fmt out_eqn
        {
            " %.0f" = H;
            " %.0f" = K;
            " %.0f" = L;
            " %.0f" = M;
            " %.8g" = D_spacing;
            " %.8g" = 2 Rad Th;
            " %.8g" = I_no_scale_pks;
            " %.8g" = I_after_scale_pks;
            " %.8g" = Iobs_no_scale_pks;
            " %.8g" = A01;
            " %.8g" = B01;
            " %.8g" = A11;
            " %.8g\n" = B11;
        }

' --- fit profile (headerless: X Yobs 1/sig^2 Ycalc Yobs-Ycalc bkg) ---
xdd_out "example_LaB6_topas_profile.txt" load out_record out_fmt out_eqn
{
    " %.8g" = X;
    " %.8g" = Yobs;
    " %.8g" = 1 / SigmaYobs^2;
    " %.8g" = Ycalc;
    " %.8g" = Yobs - Ycalc;
    " %.8g\n" = Get(bkg);
}

' --- structured results export (comment-free CSV; parsed by roundtrip.py) ---
' raw out_record primitives (NOT the Out/Out_String macros: those comma-split)
out "example_LaB6_results.csv"
    out_record out_fmt "parameter,value,esd\n"
    out_record out_eqn = Get(r_wp); out_fmt "r_wp,%11.8g,\n"
    out_record out_eqn = Get(r_exp); out_fmt "r_exp,%11.8g,\n"
    out_record out_eqn = Get(gof); out_fmt "gof,%11.8g,\n"
    out_record out_eqn = inst_U; out_fmt "inst_U,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = inst_V; out_fmt "inst_V,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = inst_W; out_fmt "inst_W,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = inst_X; out_fmt "inst_X,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = inst_Y; out_fmt "inst_Y,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = inst_Z; out_fmt "inst_Z,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = chebyshev_bkg_bkg0__; out_fmt "chebyshev_bkg_bkg0__,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = chebyshev_bkg_bkg1__; out_fmt "chebyshev_bkg_bkg1__,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = chebyshev_bkg_bkg2__; out_fmt "chebyshev_bkg_bkg2__,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = chebyshev_bkg_bkg3__; out_fmt "chebyshev_bkg_bkg3__,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = chebyshev_bkg_bkg4__; out_fmt "chebyshev_bkg_bkg4__,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = chebyshev_bkg_bkg5__; out_fmt "chebyshev_bkg_bkg5__,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = bkgpk0_pos; out_fmt "bkgpk0_pos,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = bkgpk0_int; out_fmt "bkgpk0_int,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = bkgpk0_sig; out_fmt "bkgpk0_sig,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = bkgpk0_gam; out_fmt "bkgpk0_gam,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = LaB6_scale; out_fmt "LaB6_scale,%11.8g," out_fmt_err "%11.8g\n"
' per-phase cell report (a,b,c,al,be,ga,volume with TOPAS ESDs)
    out_record out_eqn = LaB6_a; out_fmt "LaB6_cell_a,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = LaB6_a; out_fmt "LaB6_cell_b,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = LaB6_a; out_fmt "LaB6_cell_c,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = 90; out_fmt "LaB6_cell_alpha,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = 90; out_fmt "LaB6_cell_beta,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = 90; out_fmt "LaB6_cell_gamma,%11.8g," out_fmt_err "%11.8g\n"
    out_record out_eqn = (LaB6_a) * (LaB6_a) * (LaB6_a) * Sqrt(1 - Cos((90) * Pi / 180)^2 - Cos((90) * Pi / 180)^2 - Cos((90) * Pi / 180)^2 + 2 * Cos((90) * Pi / 180) * Cos((90) * Pi / 180) * Cos((90) * Pi / 180)); out_fmt "LaB6_cell_volume,%11.8g," out_fmt_err "%11.8g\n"
